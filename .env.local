# ── Required: you must fill these in ─────────────────────────
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# ── Local defaults / app secret ──────────────────────────────
# `POSTGRES_PASSWORD=postgres` matches docker-compose.yml for local dev.
# Generate `SECRET_KEY` with `openssl rand -hex 32`.
POSTGRES_PASSWORD=postgres
SECRET_KEY=change-me

# ── Database for host-run commands ───────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=pensabot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis for host-run commands ──────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── App defaults ─────────────────────────────────────────────
BASE_URL=http://localhost:8000
MEDIA_DIR=./media
