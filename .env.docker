# ── Required: you must fill these in ─────────────────────────
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# ── Secrets: generate with `openssl rand -hex 32` ───────────
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me

# ── Database for docker-compose.server.yml ───────────────────
POSTGRES_USER=postgres
POSTGRES_DB=pensabot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis for docker-compose.server.yml ──────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── App defaults ─────────────────────────────────────────────
BASE_URL=http://localhost:8000
MEDIA_DIR=/app/media
